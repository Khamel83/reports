#!/usr/bin/env python3
"""Put the reply box at the end of every report page in the content tree.

usage: report-reply-box <content-dir>

The box is a plain HTML form (no script) that posts to /_/reply, where the reply Worker saves it for Factory.
Each page gets one box, between the markers below, before the footer (or before </main>). A second run replaces the box, so a new
box version reaches every page. The dashboard pages (/ and everything under /_/) get no box.
Answer buttons come from <meta name="report:choices" content="A|B">: one button for each choice, at most 6.
Each decision card (<div class="card ask" data-choices="A|B">) also gets its own answer: one pick for each choice
(at most 6) and a note field, between the ASK markers. They belong to the reply form by its id (the HTML form
attribute), so one Send at the end sends every answer, with no script. At most MAX_ASKS cards per page get one.
"""
import html
import subprocess
import os
import re
import sys

START, END = "<!-- reply-box -->", "<!-- /reply-box -->"
NAME = re.compile(r"[a-z0-9][a-z0-9._-]{0,63}\Z")  # the Worker's limits: a page it refuses gets no box
SLUG = re.compile(r"[a-z0-9][a-z0-9-]{0,127}\Z")
STAMP = re.compile(r'(href="/_/tokens\.css)\?v=\w+"')
OLD = re.compile(re.escape(START) + r".*?" + re.escape(END) + r"\n?", re.S)
ASK_START, ASK_END = "<!-- ask-answer -->", "<!-- /ask-answer -->"
OLD_ASK = re.compile(re.escape(ASK_START) + r".*?" + re.escape(ASK_END), re.S)
ASK = re.compile(r'<div class="card ask"([^>]*)>')
MAX_ASKS = 12  # the Worker reads q1..q12


def meta(page, name):
    page = re.sub(r"<!--.*?-->", "", page, flags=re.S)  # an example tag in a comment is not a choice
    found = re.search(r'<meta name="report:' + name + r'" content="([^"]*)"', page)
    return html.unescape(found.group(1)) if found else ""


def cut(text, limit):
    """At most limit UTF-16 units, as the Worker counts (JavaScript string length)."""
    while len(text.encode("utf-16-le")) // 2 > limit:
        text = text[:-1]
    return text


def text_of(fragment):
    return html.unescape(re.sub(r"<[^>]+>", "", fragment)).strip()


def card_end(page, at):
    """Index of the </div> that closes the <div> opened at `at` (cards may hold other divs)."""
    depth = 0
    for tag in re.finditer(r"<(/?)div\b[^>]*>", page[at:]):
        depth += -1 if tag.group(1) else 1
        if depth == 0:
            return at + tag.start()
    return -1


def answers(page):
    """Put one answer block in each decision card. The question is the card's h3."""
    out, pos, n = [], 0, 0
    for found in ASK.finditer(page):
        if found.start() < pos:
            continue
        end = card_end(page, found.start())
        if end < 0 or n >= MAX_ASKS:
            break
        n += 1
        card = page[found.start():end]
        head = re.search(r"<h3[^>]*>(.*?)</h3>", card, re.S)
        question = cut(re.sub(r"\s+", " ", text_of(head.group(1))) if head else f"Decision {n}", 200)
        given = re.search(r'data-choices="([^"]*)"', found.group(1))
        picks = [c.strip() for c in html.unescape(given.group(1)).split("|") if c.strip()][:6] if given else []
        radios = "".join(f'<label class="pick"><input type="radio" form="reply-form" name="a{n}" value="{html.escape(cut(c, 80))}">'
                         f'<span>{html.escape(cut(c, 80))}</span></label>' for c in picks)
        block = (f'{ASK_START}<div class="answer"><input type="hidden" form="reply-form" name="q{n}" value="{html.escape(question)}">'
                 f'{radios}<input type="text" form="reply-form" name="n{n}" maxlength="500" placeholder="Note (optional)" '
                 f'aria-label="Note on: {html.escape(question)}"></div>{ASK_END}')
        out.append(page[pos:end] + block)
        pos = end
    return "".join(out) + page[pos:]


def box(page, repo, slug):
    title = re.search(r"<title>(.*?)</title>", page, re.S)
    fields = dict(repo=repo, slug=slug, ticket=cut(meta(page, "ticket"), 64),
                  title=cut(html.unescape(title.group(1)).strip(), 200) if title else "")
    hidden = "".join(f'<input type="hidden" name="{key}" value="{html.escape(value)}">'
                     for key, value in fields.items())
    choices = [c.strip() for c in meta(page, "choices").split("|") if c.strip()][:6]
    buttons = "".join(f'<button class="choice" name="choice" value="{html.escape(cut(c, 80))}">{html.escape(cut(c, 80))}</button>'
                      for c in choices)
    return (f'{START}\n<section class="reply" id="reply">\n<h2>Reply</h2>\n'
            f'<form method="post" action="/_/reply" id="reply-form">{hidden}\n'
            '<label for="reply-text">Anything else. Send also sends your answers in the decision cards above. The next page says if the inbox saved it.</label>\n'
            '<textarea id="reply-text" name="text" rows="4" maxlength="4000"></textarea>\n'
            f'<div class="actions">{buttons}<button class="btn" name="choice" value="">Send</button></div>\n'
            f'</form>\n</section>\n{END}\n')


def apply(page, repo, slug):
    """Return the page with exactly one current box, or the page unchanged when it has no </main>."""
    if page.rfind("</main>") < 0:
        return page
    page = answers(OLD_ASK.sub("", OLD.sub("", page)))
    end = page.rfind("</main>")
    footer = page.rfind('<footer class="meta"', 0, end)
    at = footer if footer >= 0 else end
    return page[:at] + box(page, repo, slug) + page[at:]


def main(root):
    changed = 0
    for repo in sorted(os.listdir(root)):
        if not NAME.match(repo) or not os.path.isdir(os.path.join(root, repo)):
            continue  # "_" (dashboard, stylesheet) and ".git" do not match NAME
        for slug in sorted(os.listdir(os.path.join(root, repo))):
            path = os.path.join(root, repo, slug, "index.html")
            if not SLUG.match(slug) or not os.path.isfile(path):
                continue
            with open(path, encoding="utf-8") as handle:
                page = handle.read()
            new = apply(page, repo, slug)
            if new != page:
                tmp = path + ".tmp"  # write beside the page, then rename: a kill never leaves a cut page
                with open(tmp, "w", encoding="utf-8") as handle:
                    handle.write(new)
                os.replace(tmp, path)
                changed += 1
    return changed


def layout_only(root):
    """True when every uncommitted change differs from HEAD only by the box and the stylesheet stamp (a killed run)."""
    git = lambda *a: subprocess.run(["git", "-C", root, "-c", "core.quotePath=false", *a],
                                    capture_output=True, text=True, encoding="utf-8")
    plain = lambda page: STAMP.sub(r'\1"', OLD_ASK.sub("", OLD.sub("", page)))
    paths = [line[3:] for line in git("status", "--porcelain", "--untracked-files=all").stdout.splitlines()]
    for path in paths:
        if path == "_/tokens.css":
            continue
        old = git("show", "HEAD:" + path)
        if not (path == "index.html" or path.endswith("/index.html")) or old.returncode != 0 or not os.path.isfile(os.path.join(root, path)):
            return False
        with open(os.path.join(root, path), encoding="utf-8") as stream:
            if plain(stream.read()) != plain(old.stdout):
                return False
    return bool(paths)


if __name__ == "__main__":
    if len(sys.argv) == 3 and sys.argv[1] == "--layout-only":
        sys.exit(0 if layout_only(sys.argv[2]) else 1)
    if len(sys.argv) != 2:
        sys.exit("usage: report-reply-box <content-dir> | report-reply-box --layout-only <content-dir>")
    print(f"reply box: {main(sys.argv[1])} page(s) changed", file=sys.stderr)

#!/usr/bin/env python3
"""Morning report: one page for all the bed reports of one night, and one message to the owner.

usage: report-morning build <content-dir> <date> <out.html>   prints the message as JSON; exit 3 if no bed reports
       report-morning send <message.json>                     sends it through Drop, prints the receipt as JSON
env  : REPORTS_HOST (default reports.khamel.com)
       send only: DROP_NOTIFY_URL, DROP_NOTIFY_TOKEN_FILE, INBOX_CHANNEL_ID

A bed report is the page <repo>/bed-<date>[-<topic>]/index.html with <meta name="report:kind" content="bed">.
<date> is the date of the morning the owner reads it (see the bed skill). Its <meta name="bed:status"> is
done, working or blocked. Each `.card.ask` h3 is one thing the owner must do.
"""
import html
import json
import os
import re
import subprocess
import sys
import time
import urllib.request
from datetime import datetime, timezone
from zoneinfo import ZoneInfo

PT = ZoneInfo("America/Los_Angeles")
HOST = os.environ.get("REPORTS_HOST", "reports.khamel.com")
NAME = re.compile(r"[a-z0-9][a-z0-9._-]*\Z")
DATE = re.compile(r"\d{4}-\d{2}-\d{2}\Z")
STATUS_TAG = {"done": "good", "working": "warn", "blocked": "bad"}
SUMMARY_MAX, TITLE_MAX = 2000, 160  # Drop notification v1 limits


def text(fragment):
    """Visible text of an HTML fragment, one line."""
    return " ".join(html.unescape(re.sub(r"<[^>]+>", " ", fragment)).split())


def meta(page, name):
    found = re.search(rf'<meta name="{re.escape(name)}" content="([^"]*)"', page)
    return html.unescape(found.group(1)).strip().lower() if found else ""


def changed(root, rel):
    """Last commit time of the page, else its file time."""
    try:
        out = subprocess.run(["git", "-C", root, "log", "-1", "--format=%at", "--", rel],
                             capture_output=True, text=True, check=True).stdout.strip()
    except (subprocess.CalledProcessError, FileNotFoundError):
        out = ""
    return datetime.fromtimestamp(int(out) if out else os.path.getmtime(os.path.join(root, rel)), PT)


def collect(root, date):
    rows = []
    for repo in sorted(os.listdir(root)):
        if not NAME.match(repo) or not os.path.isdir(os.path.join(root, repo)):
            continue
        for slug in sorted(os.listdir(os.path.join(root, repo))):
            rel = f"{repo}/{slug}/index.html"
            path = os.path.join(root, rel)
            if not (slug == f"bed-{date}" or slug.startswith(f"bed-{date}-")) or not os.path.isfile(path):
                continue
            page = open(path, encoding="utf-8").read()
            if meta(page, "report:kind") != "bed":
                continue
            title = re.search(r"<title>(.*?)</title>", page, re.S)
            lede = re.search(r'<p class="lede">(.*?)</p>', page, re.S)
            status = meta(page, "bed:status")
            rows.append(dict(
                repo=repo, path=f"/{repo}/{slug}/",
                title=text(title.group(1)) if title else slug,
                lede=text(lede.group(1)) if lede else "",
                status=status if status in STATUS_TAG else "unknown",
                stats=[(text(b), text(label)) for b, label in
                       re.findall(r'<div class="stat"><b>(.*?)</b>(.*?)</div>', page, re.S)],
                asks=[text(h) for h in re.findall(r'<div class="card ask">\s*<h3>(.*?)</h3>', page, re.S)],
                when=changed(root, rel)))
    return rows


def counts(rows):
    by = {s: sum(r["status"] == s for r in rows) for s in ("done", "working", "blocked")}
    return by, sum(len(r["asks"]) for r in rows)


def render(rows, date):
    e = html.escape
    by, asks = counts(rows)
    day = datetime.strptime(date, "%Y-%m-%d").strftime("%A, %B %-d")
    ask_cards = "".join(
        f'<div class="card ask"><h3>{e(r["repo"])}: {e(a)}</h3>'
        f'<p><a class="btn" href="{e(r["path"])}">Open the {e(r["repo"])} report</a></p></div>\n'
        for r in rows for a in r["asks"])
    cards = "".join(
        f'<div class="card"><h3>{e(r["repo"])} <span class="tag {STATUS_TAG.get(r["status"], "")}">{e(r["status"])}</span></h3>'
        f'<p><strong>{e(r["title"])}</strong></p><p>{e(r["lede"])}</p>'
        + (f'<p>{" · ".join(f"<b>{e(b)}</b> {e(label)}" for b, label in r["stats"])}</p>' if r["stats"] else "")
        + f'<p><small>Last change {r["when"].strftime("%b %-d, %-I:%M %p PT")}</small></p>'
        f'<p><a class="btn" href="{e(r["path"])}">Open report</a></p></div>\n'
        for r in rows)
    needs = (f'<section>\n<h2>Needs you</h2>\n{ask_cards}</section>\n' if ask_cards else "")
    return f"""<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>While you slept: {e(day)}</title>
<meta name="report:kind" content="morning"><meta name="report:repo" content="reports"><meta name="report:ticket" content="bed"><meta name="report:created" content="{e(date)}">
<link rel="stylesheet" href="/_/tokens.css">
</head><body><main>
<header class="hero">
<p class="kicker">reports · bed · {e(date)}</p>
<h1>While you slept</h1>
<p class="lede">{len(rows)} projects worked overnight: {by["done"]} done, {by["working"]} still working, {by["blocked"]} blocked. {asks} things need you.</p>
<div class="stats">
<div class="stat"><b>{len(rows)}</b>projects</div>
<div class="stat"><b>{by["done"]}</b>done</div>
<div class="stat"><b>{by["working"] + by["blocked"]}</b>not done</div>
<div class="stat"><b>{asks}</b>need you</div>
</div>
</header>
{needs}<section>
<h2>Projects</h2>
<div class="grid">
{cards}</div>
</section>
<footer class="meta">Made by <code>bin/report-morning</code> from the bed reports for {e(day)}. Each card repeats its report's own
summary; open the report for the evidence. A status is what the session wrote last, not a check by this page.</footer>
</main></body></html>
"""


def message(rows, date):
    by, asks = counts(rows)
    title = f"While you slept: {len(rows)} projects, {by['done']} done, {asks} need you"[:TITLE_MAX]
    lines = [f"• {r['repo']} [{r['status']}]: {r['lede'] or r['title']}"
             + (f" (needs you: {len(r['asks'])})" if r["asks"] else "") for r in rows]
    summary = ""
    for index, line in enumerate(lines):
        rest = f"\n… and {len(lines) - index} more in the report"
        if len(summary) + len(line) + 1 + len(rest) > SUMMARY_MAX:
            summary += rest
            break
        summary += ("\n" if summary else "") + line
    return dict(schema_version="drop.notification.v1", event_id=f"reports:morning:{date}",
                operation="slack.messages.send", content_kind="status_change",
                observed_at=datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
                title=title, summary=summary[:SUMMARY_MAX],
                source_url=f"https://{HOST}/reports/morning-{date}/")


def call(method, url, token, body=None):
    request = urllib.request.Request(url, method=method, data=None if body is None else json.dumps(body).encode(),
                                     headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"})
    with urllib.request.urlopen(request, timeout=30) as response:
        return json.loads(response.read())


def send(msg, base, token, channel, http=call, polls=12, wait=10):
    """POST once, then read the receipt until Slack delivery is proved. At most 1 + polls requests."""
    receipt = http("POST", f"{base}/v1/notifications", token, dict(msg, channel_id=channel))
    for _ in range(polls):
        if receipt["state"] in ("delivered", "failed", "delivery_uncertain"):
            break
        time.sleep(wait)
        receipt = http("GET", f"{base}/v1/notifications/{receipt['receipt_id']}", token)
    return receipt


def main():
    args = sys.argv[1:]
    if len(args) == 4 and args[0] == "build" and DATE.match(args[2]):
        rows = collect(args[1], args[2])
        if not rows:
            print(f"no bed reports for {args[2]}", file=sys.stderr)
            sys.exit(3)
        with open(args[3], "w", encoding="utf-8") as handle:
            handle.write(render(rows, args[2]))
        print(json.dumps(message(rows, args[2])))
    elif len(args) == 2 and args[0] == "send":
        base = os.environ["DROP_NOTIFY_URL"].rstrip("/")
        token = open(os.environ["DROP_NOTIFY_TOKEN_FILE"], encoding="utf-8").read().strip()
        receipt = send(json.load(open(args[1], encoding="utf-8")), base, token, os.environ["INBOX_CHANNEL_ID"])
        print(json.dumps(receipt))
        sys.exit(0 if receipt["state"] == "delivered" and receipt.get("provider_receipt") else 1)
    else:
        print(__doc__.split("\n\n")[1], file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main()

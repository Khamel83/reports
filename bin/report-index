#!/usr/bin/env python3
"""Write the dashboard: <content>/index.html (by day) and <content>/_/by-repo/index.html (by repo).

usage: report-index <content-dir>
env  : REPORTS_HOST (default reports.khamel.com)

Kind and title come from each page's <meta name="report:kind"> and <title>; the repo is the folder name.
The date is the page's last change: its last commit in the content repo, or now when this publish changes it.
A publish of identical HTML is not a change and keeps the date, by design.
"""
import html
import os
import re
import subprocess
import sys
import time
from datetime import datetime
from zoneinfo import ZoneInfo

PT = ZoneInfo("America/Los_Angeles")
HOST = os.environ.get("REPORTS_HOST", "reports.khamel.com")
NAME = re.compile(r"[a-z0-9][a-z0-9._-]*\Z")  # the names bin/report accepts; anything else is not a report
VIEWS = {"day": ("/", "index.html"), "repo": ("/_/by-repo/", os.path.join("_", "by-repo", "index.html"))}


def change_times(root):
    """Path -> author time of its last commit; paths this publish changes get now.

    Author time, so a restyle of old pages can keep their dates with `git commit --date`.
    Empty when root is not a git repo; then collect() uses file times.
    """
    def git(*args):  # quotePath off and -z: paths come back literal, as collect() looks them up
        return subprocess.run(["git", "-C", root, "-c", "core.quotePath=false", *args],
                              capture_output=True, text=True, check=True).stdout
    times, stamp = {}, None
    try:
        for line in git("log", "--format=@%at", "--name-only").splitlines():
            if line.startswith("@"):
                stamp = int(line[1:])
            elif line:
                times.setdefault(line, stamp)
    except (subprocess.CalledProcessError, FileNotFoundError):
        pass  # no commits yet, or not a git repo
    try:  # staged, unstaged and untracked paths: bin/report commits them all next
        fields = git("status", "--porcelain", "-z", "--untracked-files=all").split("\0")
    except (subprocess.CalledProcessError, FileNotFoundError):
        return times
    now, index = int(time.time()), 0
    while index < len(fields):
        entry = fields[index]
        index += 1
        if len(entry) > 3:
            times[entry[3:]] = now
            if "R" in entry[:2] or "C" in entry[:2]:
                index += 1  # a rename or copy carries its old path as one more field
    return times


def collect(root):
    times, rows = change_times(root), []
    for repo in sorted(os.listdir(root)):
        if not NAME.match(repo) or not os.path.isdir(os.path.join(root, repo)):
            continue
        for slug in sorted(os.listdir(os.path.join(root, repo))):
            rel = f"{repo}/{slug}/index.html"
            path = os.path.join(root, rel)
            if not NAME.match(slug) or not os.path.isfile(path):
                continue
            page = open(path, encoding="utf-8").read()
            title = re.search(r"<title>(.*?)</title>", page, re.S)
            kind = re.search(r'<meta name="report:kind" content="([^"]*)"', page)
            rows.append(dict(
                repo=repo, path=f"/{repo}/{slug}/",
                title=html.unescape(title.group(1)).strip() if title else slug,
                kind=(html.unescape(kind.group(1)).strip().lower() if kind else "") or "report",
                when=datetime.fromtimestamp(times.get(rel) or os.path.getmtime(path), PT)))
    return sorted(rows, key=lambda row: row["when"], reverse=True)


def clock(when):
    return when.strftime("%b %-d, %-I:%M %p PT")


def listing(rows):
    """One row per page: kind, repo, title over its full link, time of last change."""
    host = html.escape(HOST)
    items = "".join(
        f'<li><span class="tag">{html.escape(r["kind"])}</span><span>{html.escape(r["repo"])}</span>'
        f'<span><a href="{html.escape(r["path"])}">{html.escape(r["title"])}</a>'
        f'<small><a href="https://{host}{html.escape(r["path"])}">{host}{html.escape(r["path"])}</a></small></span>'
        f'<time datetime="{r["when"].isoformat()}">{clock(r["when"])}</time></li>\n'
        for r in rows)
    return f'<ul class="rows">\n{items}</ul>'


def render(view, rows):
    groups = {}
    for row in rows:  # rows are newest first, so groups and their rows are too
        key = row["when"].strftime("%A, %B %-d, %Y") if view == "day" else row["repo"]
        groups.setdefault(key, []).append(row)
    sections = "".join(f"<section>\n<h2>{html.escape(key)}</h2>\n{listing(group)}\n</section>\n"
                       for key, group in groups.items())
    switch = " · ".join(f"<strong>by {name}</strong>" if name == view else f'<a href="{VIEWS[name][0]}">by {name}</a>'
                        for name in VIEWS)
    latest = rows[0]["when"].strftime("%b %-d") if rows else "none"
    return f"""<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Reports</title>
<link rel="stylesheet" href="/_/tokens.css">
</head><body><main>
<header class="hero">
<p class="kicker">{html.escape(HOST)}</p>
<h1>Reports</h1>
<p class="lede">Everything the agents published for you to read, newest first. View: {switch}.</p>
<div class="stats">
<div class="stat"><b>{len(rows)}</b>pages</div>
<div class="stat"><b>{len({r["repo"] for r in rows})}</b>repos</div>
<div class="stat"><b>{latest}</b>latest change</div>
</div>
</header>
{sections}<footer class="meta">Made by <code>bin/report-index</code> at each publish. Times are the last change of each page, Pacific time.</footer>
</main></body></html>
"""


def main():
    root = sys.argv[1]
    rows = collect(root)
    for view, (_, target) in VIEWS.items():
        path = os.path.join(root, target)
        os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
        with open(path, "w", encoding="utf-8") as handle:
            handle.write(render(view, rows))
    print(f"dashboard: {len(rows)} pages", file=sys.stderr)


if __name__ == "__main__":
    main()

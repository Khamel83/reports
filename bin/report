#!/usr/bin/env bash
# report publish <repo> <slug> <file.html>   (see README.md)
set -euo pipefail
[ "${1:-}" = publish ] && [ $# -eq 4 ] || { echo "usage: report publish <repo> <slug> <file.html>" >&2; exit 2; }
repo=$2 slug=$3 file=$4
[[ $repo =~ ^[a-z0-9][a-z0-9._-]*$ && $slug =~ ^[a-z0-9][a-z0-9-]*$ ]] || { echo "repo and slug: lowercase letters, digits, - . _" >&2; exit 2; }
: "${REPORTS_CONTENT_DIR:?}" "${REPORTS_PROJECT:?}" "${CLOUDFLARE_API_TOKEN:?}" "${CLOUDFLARE_ACCOUNT_ID:?}"
grep -qE 'href="/_/tokens\.css(\?v=[0-9a-z]+)?"' "$file" || { echo "report must link /_/tokens.css" >&2; exit 2; }
here=$(cd "$(dirname "$0")/.." && pwd)
# One publish at a time on the content checkout: the reset below must never touch another run's files. The lock is a
# kernel lock (flock) on a file in .git, held through fd 9 by this shell; the kernel drops it when the run ends in any
# way (exit, kill, power loss), so no stale lock is left. Wait up to 5 min.
lock="$REPORTS_CONTENT_DIR/.git/report-publish.lock"
exec 9>>"$lock"
python3 -I -c 'import fcntl, sys, time
for _ in range(300):
    try:
        fcntl.flock(9, fcntl.LOCK_EX | fcntl.LOCK_NB); sys.exit(0)
    except BlockingIOError:
        time.sleep(1)
sys.exit(3)' || { echo "another publish holds $lock" >&2; exit 3; }
dest="$REPORTS_CONTENT_DIR/$repo/$slug"; mkdir -p "$dest" "$REPORTS_CONTENT_DIR/_"
# Browsers keep /_/tokens.css for hours (the host sends max-age=14400), so every page links it with a version.
# A new stylesheet restamps all pages; that commit starts with "restyle", which the dashboard does not count as a change.
v=$(cksum < "$here/tokens.css" | cut -d' ' -f1)
stamp() { find "$REPORTS_CONTENT_DIR" -name index.html -not -path '*/.git/*' -exec \
  perl -pi -e 's{href="/_/tokens\.css(\?v=\w+)?"}{href="/_/tokens.css?v='"$v"'"}g' {} +; }
# Commit everything staged under one label. No change: no commit. A failed step stops the publish (set -e) and the
# reset below, so restyle lines never fall into a report or content commit and move every page's dashboard date.
commit() { git -C "$REPORTS_CONTENT_DIR" add -A; git -C "$REPORTS_CONTENT_DIR" diff --cached --quiet || git -C "$REPORTS_CONTENT_DIR" commit -qm "$1"; }
# Edits already in the tree are content, not layout: commit them first. Then the stylesheet and the stamp are the
# "restyle" commit, and the new page is the "report" commit.
# Leftovers of a killed run (only _/tokens.css and stamp edits) are layout: file them as "restyle:", not content.
left=$(git -C "$REPORTS_CONTENT_DIR" status --porcelain | cut -c4-)
if [ -n "$left" ] && ! git -C "$REPORTS_CONTENT_DIR" diff -U0 HEAD -- . ':(exclude)_/tokens.css' | grep -E '^[+-]' | grep -vE '^(\+\+\+|---) (a/|b/|/dev/null)' | grep -vqE 'href="/_/tokens\.css(\?v=\w+)?"' \
   && ! printf '%s\n' "$left" | grep -vqE '(^_/tokens\.css$|/index\.html$|^index\.html$)'; then
  commit "restyle: leftovers of an interrupted publish"
fi
commit "content: earlier uncommitted changes"
# From here the tree holds only what this publish writes (stylesheet, stamps, page, dashboard), all made again by a
# new run. A failed run resets it to the last commit, so stamps never wait to fall into a later "content" commit.
# A killed run (SIGKILL, power loss) skips the trap; the leftover check above files those edits as "restyle:".
reset() { git -C "$REPORTS_CONTENT_DIR" reset -q --hard HEAD; git -C "$REPORTS_CONTENT_DIR" clean -fdq; echo "publish failed: content tree reset to the last commit" >&2; }
trap 'rc=$?; [ $rc -eq 0 ] || reset' EXIT
cp "$here/tokens.css" "$REPORTS_CONTENT_DIR/_/tokens.css"; stamp; commit "restyle: stylesheet $v"
cp "$file" "$dest/index.html"; stamp
"$here/bin/report-index" "$REPORTS_CONTENT_DIR"; stamp  # dashboard at / and /_/by-repo/
commit "report: $repo/$slug"
trap - EXIT  # all committed; push and deploy failures leave nothing to reset
git -C "$REPORTS_CONTENT_DIR" push -q origin HEAD || echo "warning: content backup push failed" >&2
cd "$REPORTS_CONTENT_DIR"  # Pagecast writes .pagecast/ into the current directory
DO_NOT_TRACK=1 PAGECAST_TELEMETRY=0 npx --yes pagecast@0.7.0 pages deploy "$REPORTS_CONTENT_DIR" --project "$REPORTS_PROJECT" --json >/dev/null
echo "published: /$repo/$slug/"
